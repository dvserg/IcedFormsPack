// Функция-помощник для создания Arc (вызовется автоматически внутри Factory::default)
fn create_button_creator() -> Box<dyn WidgetCreator + Send + Sync> {
    log::info!("Авторегистрация '{}'", "Button");
    Box::new(ButtonCreator)
}

