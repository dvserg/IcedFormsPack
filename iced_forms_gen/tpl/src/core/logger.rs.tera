{# Файл: templates/src/core/loggers.rs.tera #}
use flexi_logger::{Logger, FileSpec, Duplicate, Criterion, Naming, Cleanup, detailed_format, DeferredNow, WriteMode};
use log::{info, warn, Record};

pub fn init() {
    let exe_name = std::env::current_exe()
        .ok()
        .and_then(|path| path.file_stem().map(|s| s.to_string_lossy().into_owned()))
        .unwrap_or_else(|| "iced_forms_app".to_string());

    let log_filter = format!("warn, {}=info, {}=trace", exe_name, exe_name);

    Logger::try_with_str(&log_filter)
        .unwrap()
        .log_to_file(FileSpec::default().directory("logs").basename("editor"))
        .duplicate_to_stderr(Duplicate::All)
        .format(detailed_format)
        .format_for_stderr(console_format)
        .rotate(
            Criterion::Size(10 * 1024 * 1024),
            Naming::Timestamps,
            Cleanup::KeepLogFiles(5),
        )
        .write_mode(WriteMode::Direct)
        .start()
        .unwrap();
}

pub fn init_logger() -> flexi_logger::LoggerHandle {
    // 🛸 АВТОМАТ РАНТАЙМА: Узнаем имя текущего запущенного процесса прямо из ОС!
    let exe_name = std::env::current_exe()
        .ok()
        .and_then(|path| path.file_stem().map(|s| s.to_string_lossy().into_owned()))
        .unwrap_or_else(|| "iced_forms_gen".to_string());

    // 🔥 ИДЕАЛЬНЫЙ ВСЕЯДНЫЙ ФИЛЬТР: 
    // Задаем базовый уровень warn для всех внешних систем (iced, wgpu, windowing),
    // но для текущего исполняемого модуля (как бы его ни переименовали) — включаем info и trace!
    let log_filter = format!("warn, {}=info, {}=trace", exe_name, exe_name);

    Logger::try_with_str(&log_filter)
        .unwrap()
        .format(detailed_format)
        .log_to_file(
            FileSpec::default()
                .directory("logs")
                // 🔥 УБИРАЕМ ХАРДКОД "editor": Логи на диске будут называться именем запущенной программы!
                .basename(&exe_name) 
        )
        .duplicate_to_stderr(Duplicate::All)
        .format_for_stderr(console_format)
        .rotate(
            Criterion::Size(10 * 1024 * 1024),
            Naming::Timestamps,
            Cleanup::KeepLogFiles(5),
        )
        .start()
        .unwrap()
}


pub fn console_format(
    w: &mut dyn std::io::Write,
    _now: &mut DeferredNow, 
    record: &Record,
) -> Result<(), std::io::Error> {
    write!(w, "[{}] {}\n", record.level(), record.args())
}
