{# Файл: templates/widgets/pick_list.tera #}
{% macro get_imports() %}
    iced::widget::pick_list,
    iced::{Length, Padding, Element, Theme},
{% endmacro %}

{# 📐 Извлекаем из ОЗУ готовую геометрию #}
{%- set padding_code = widget.properties | get(key="padding_code", default="") -%}

{# 🛰️ Извлекаем строковые параметры состояния выпадающего списка #}
{# "selected_code" — это переменная в приложении, где хранится текущий выбор (например, "app.selected_item") #}
{%- set selected_var = widget.properties | get(key="selected_code", default="app.selected_item") -%}

{# 🎛️ Извлекаем реактивное событие изменения выбора #}
{%- set action_name = widget.properties | get(key="action", default="") | trim -%}

{# 📦 Статический массив вариантов для генерации на стеке (извлекаем массив из свойств виджета) #}
{%- set options_list = widget.properties | get(key="options", default=[]) -%}

pick_list(
    {# Формируем статический массив строк Rust прямо на стеке функции #}
    &[
        {%- for option in options_list -%}
        "{{ option }}".to_string(),
        {%- endfor -%}
    ],
    Some({{ selected_var }}.clone()),
    {# Если пользователь выбирает элемент — отправляем экшен, иначе NoOp-заглушку с игнорированием аргумента #}
    {%- if action_name != "" and action_name != "None" -%}
        crate::core::Message::WidgetEvent(
            crate::core::Message::WidgetAction::OnInputChange(
                "{{ id }}".to_string(),
                "{{ action_name }}".to_string(),
                _
            )
        )
    {%- else -%}

        |_| crate::core::Message::NoOp
    {%- endif -%}
)
    {# 📐 Высота и Ширина выпадающего списка #}
    {%- if widget.properties.width_code -%}.width({{ widget.properties.width_code }}){%- endif -%}
    {%- if widget.properties.height_code -%}.height({{ widget.properties.height_code }}){%- endif -%}

    {# 📐 Снайперский вывод отступов выпадающего списка из ОЗУ #}
    {%- if padding_code -%}.padding({{ padding_code }}){%- endif -%}

    {# 📐 Размер шрифта внутри списка, если переопределен в VTable #}
    {%- if widget.properties.text_size_code -%}
        .text_size({{ widget.properties.text_size_code }})
    {%- endif -%}
