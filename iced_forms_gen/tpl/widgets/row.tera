{# Файл: templates/widgets/row.tera #}
{% macro get_imports() %}
    iced::widget::row,
    iced::{Length, Padding, Alignment, Element, Theme},
{% endmacro %}

{# 📐 Извлекаем из ОЗУ готовый монолитный код геометрии и параметров #}
{%- set padding_code = widget.properties | get(key="padding_code", default="") -%}
{%- set spacing_code = widget.properties | get(key="spacing_code", default="") -%}

{# 🛸 Создаем локальный массив для сбора только тех детей, у которых parent == ID этой строки #}
{%- set child_ids = [] -%}
{%- for potential_child_id in widgets_order -%}
    {%- set child_widget = widgets[potential_child_id] -%}
    {%- if child_widget.properties and child_widget.properties.parent == id -%}
        {%- set_global child_ids = child_ids | concat(with=potential_child_id) -%}
    {%- endif -%}
{%- endfor -%}

row![
    {%- for child_id in child_ids %}
    {{ child_id }},
    {%- endfor %}
]
    {# 📐 Расстояние между элементами внутри строки по горизонтали #}
    {%- if spacing_code -%}
        .spacing({{ spacing_code }})
    {%- endif -%}

    {# 📐 Высота и Ширина строки #}
    {%- if widget.properties.width_code -%}.width({{ widget.properties.width_code }}){%- endif -%}
    {%- if widget.properties.height_code -%}.height({{ widget.properties.height_code }}){%- endif -%}

    {# 📐 Снайперский вывод отступов Iced 0.14 одной строкой из ОЗУ #}
    {%- if padding_code -%}
        .padding({{ padding_code }})
    {%- endif -%}

    {# 🎛️ Выравнивание элементов по вертикали (если задано в VTable) #}
    {%- if widget.properties.align_items_code -%}
        .align_x({{ widget.properties.align_items_code }})
    {%- endif -%}
