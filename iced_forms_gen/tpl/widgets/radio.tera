{# Файл: templates/widgets/radio.tera #}
{% macro get_imports() %}
    iced::widget::radio,
    iced::{Length, Padding, Element, Theme},
{% endmacro %}

{# Извлекаем из ОЗУ готовую геометрию #}
{%- set padding_code = widget.properties | get(key="padding_code", default="") -%}

{# Извлекаем строковые параметры состояния радио-кнопки #}
{# "value_code" — это значение конкретно ЭТОЙ радио-кнопки (например, "Dark") #}
{# "selected_code" — это переменная в приложении, где хранится текущий выбор (например, "app.theme_mode") #}
{%- set radio_label   = widget.properties | get(key="text_code", default="Вариант") -%}
{%- set current_value  = widget.properties | get(key="value_code", default="") -%}
{%- set selected_var   = widget.properties | get(key="selected_code", default="app.selected_option") -%}

{# 🎛️ Извлекаем реактивное событие изменения выбора #}
{%- set action_name = widget.properties | get(key="action", default="") | trim -%}

radio(
    {{ radio_label }},
    {{ current_value }},
    Some({{ selected_var }}.as_str()),
    {# Если пользователь кликает по радио-кнопке — отправляем экшен, иначе NoOp-заглушку с игнорированием аргумента #}
    {%- if action_name != "" and action_name != "None" -%}
        crate::core::Message::{{ action_name }}
    {%- else -%}

        |_| crate::core::Message::NoOp
    {%- endif -%}
)
    {# 📐 Высота и Ширина радио-кнопки #}
    {%- if widget.properties.width_code -%}.width({{ widget.properties.width_code }}){%- endif -%}
    {%- if widget.properties.height_code -%}.height({{ widget.properties.height_code }}){%- endif -%}

    {# 📐 Снайперский вывод отступов радио-кнопки из ОЗУ #}
    {%- if padding_code -%}
        .padding({{ padding_code }})
    {%- endif -%}

    {# 📐 Размер самого кружочка радио-кнопки, если задан в VTable #}
    {%- if widget.properties.size_code -%}
        .size({{ widget.properties.size_code }})
    {%- endif -%}
